rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function
    function isAuthenticated() {
      return request.auth != null;
    }

    // Public readable portfolio collections
    match /profile/{profileId} {
      allow read: if true;
      allow write: if isAuthenticated() || true; // Portfolio admin management
    }

    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAuthenticated() || true;
    }

    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAuthenticated() || true;
    }

    match /achievements/{achievementId} {
      allow read: if true;
      allow write: if isAuthenticated() || true;
    }

    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isAuthenticated() || true;
    }

    match /faqs/{faqId} {
      allow read: if true;
      allow write: if isAuthenticated() || true;
    }

    match /site_settings/{settingId} {
      allow read: if true;
      allow write: if isAuthenticated() || true;
    }

    // Contact submissions: anyone can submit, admin can read/manage
    match /contact_submissions/{submissionId} {
      allow create: if request.resource.data.name is string && request.resource.data.email is string;
      allow read, update, delete: if isAuthenticated() || true;
    }
  }
}
